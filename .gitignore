# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment Variables
.env
.env.dev
.env.test
.env.production
.env.development
.env.local
.env.*.local

# ...except the client's, which are committed on purpose. They hold no secrets,
# only the public frontend/backend URLs, and the CI build reads them to bake the
# WebSocket endpoint into the bundle. They were already tracked while matching
# the rules above, which made the state look accidental.
!client/.env.production
!client/.env.development

# Build Outputs
build/
dist/
client/build/

# System Files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo

# Config/Secrets
config/
*.key
*.crt
*.pem

# User Uploads
uploads/

# Testing
coverage/

# Gemini
.gemini/
design-system/
client-rsbuild/

.wrangler