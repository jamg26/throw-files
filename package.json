{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "env-cmd -f .env.dev concurrently \"npm run server\" \"npm run client\"",
    "server": "env-cmd -f .env.dev nodemon --exec ts-node index.ts",
    "client": "npm run dev --prefix client",
    "client-back": "npm start --prefix client",
    "build": "npm install --include=dev && npm install --prefix client --legacy-peer-deps && npm run build --prefix client && npx tsc",
    "heroku-postbuild": "npm run build",
    "start": "node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.1.1",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^25.2.3",
    "@types/randomstring": "^1.3.0",
    "@types/styled-components": "^5.1.36"
  }
}
