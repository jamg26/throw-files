{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "env-cmd -f .env.dev concurrently \"npm run server\" \"npm run client\"",
    "server": "env-cmd -f .env.dev nodemon --exec ts-node index.ts",
    "client": "npm run dev --prefix client",
    "client-back": "npm start --prefix client",
    "build": "set NPM_CONFIG_PRODUCTION=false && npm install && npm install -g @rsbuild/core && npm install --prefix client --legacy-peer-deps && npm run build --prefix client",
    "heroku-postbuild": "npm run build",
    "start": "ts-node index.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^10.0.0",
    "express": "^4.17.3",
    "express-rate-limit": "^6.7.0",
    "ioredis": "^5.2.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.5.1",
    "socket.io": "^4.7.5",
    "socket.io-stream": "^0.9.1",
    "socketio-file-upload": "^0.7.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.3",
    "@types/randomstring": "^1.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/socket.io": "^3.0.1",
    "@types/styled-components": "^5.1.36",
    "concurrently": "^6.5.1",
    "env-cmd": "^10.1.0",
    "nodemon": "^2.0.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
