{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "env-cmd -f .env.dev concurrently \"npm run server\" \"npm run client\"",
    "server": "env-cmd -f .env.dev nodemon index.js",
    "client": "npm run dev --prefix client",
    "client-back": "npm start --prefix client",
    "build": "set NPM_CONFIG_PRODUCTION=false && npm install && npm install -g @rsbuild/core && npm install --prefix client --legacy-peer-deps && npm run build --prefix client",
    "heroku-postbuild": "npm run build",
    "start": "node index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt-nodejs": "0.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.3",
    "express-rate-limit": "^6.7.0",
    "ioredis": "^5.2.4",
    "jwt-simple": "^0.5.6",
    "mongoose": "^6.2.10",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.5.1",
    "socket.io": "^4.7.5",
    "socket.io-stream": "^0.9.1",
    "socketio-file-upload": "^0.7.3"
  },
  "devDependencies": {
    "concurrently": "^6.5.1",
    "env-cmd": "^10.1.0",
    "nodemon": "^2.0.15"
  }
}
